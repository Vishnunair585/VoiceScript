{
  "entities": {
    "Document": {
      "title": "Document",
      "description": "A generated exam paper or answer sheet",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The ID of the user who created this document"
        },
        "rawTranscript": {
          "type": "string"
        },
        "formattedText": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "studentName": {
          "type": "string"
        },
        "examinerName": {
          "type": "string"
        },
        "createdAt": {
          "type": "timestamp"
        }
      },
      "required": ["userId", "formattedText", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/documents/{documentId}": {
      "schema": {
        "$ref": "#/entities/Document"
      },
      "description": "The documents generated by the user"
    }
  }
}
